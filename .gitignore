# ==========================================
# AI 學術文獻分析與雙語心智圖生成系統 - .gitignore
# ==========================================

# 1. Python 虛擬環境 (Virtual Environments)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 2. 環境變數與機敏金鑰 (Environment Variables & Secrets)
.env
.env.*
!.env.example

# 3. Python 編譯快取與分發包 (Bytecode & Packaging)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 4. 測試與靜態檢查快取 (Testing & Linters)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 5. 系統與執行日誌 (Logs)
*.log
logs/

# 6. 上傳暫存檔案與暫時分析結果 (Temporary Uploads & Results)
storage/temp_uploads/
storage/temp_results/
temp/
tmp/
*.tmp

# 排除暫存 PDF（注意：不排除未來放入 app/sample_data/ 的正式範例檔案）
storage/temp_uploads/*.pdf
/temp_*.pdf

# 7. 作業系統雜項檔案 (OS Generated Files)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 8. 編輯器與 IDE 設定檔 (IDE Configuration)
.vscode/
.idea/
*.swp
*.swo
*~
