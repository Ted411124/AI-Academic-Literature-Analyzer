# =================================================================
# AI Academic Literature Analyzer & Bilingual Mind Map Generator
# 環境變數範例檔 (.env.example)
#
# 注意：
# 1. 請勿將包含真實 API Key 的 .env 檔案提交至 GitHub！
# 2. 本專案恪守 NT$0 零付費原則，Gemini API 請使用 Google AI Studio 免費額度。
# =================================================================

# 伺服器執行環境 (development / production)
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Google AI Studio 免費 Gemini API Key (後續分析階段使用，本階段留空)
GEMINI_API_KEY=

# PDF 上傳安全限制
MAX_FILE_SIZE_MB=10
MAX_PAGES=50

# 速率限制與安全性 (每 IP 每日請求次數上限)
DAILY_RATE_LIMIT=60
